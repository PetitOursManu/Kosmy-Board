# Adresse publique du Board, telle que les navigateurs la voient (sans « / » final).
PUBLIC_URL=https://board.mondomaine.fr
# Lien « ← Kosmy » de l'en-tête.
KOSMY_URL=https://kosmy.mondomaine.fr
# Derrière Coolify, Traefik, Caddy ou Nginx : lire l'IP du visiteur dans X-Forwarded-For.
TRUST_PROXY=1
# Facultatif
# PORT=8767
# DATA_DIR=/data
# SESSION_DAYS=30
# DEVICE_DAYS=365
# CATALOG_URL=https://raw.githubusercontent.com/PetitOursManu/Kosmy-Mobile/main/catalog/catalog.json
# Fuseau horaire des bilans de l'Assistant.
# TZ=Europe/Paris
# Assistant IA (docs/assistant.md) : facultatif, sinon réglé dans Assistant → Réglages.
# AI_PROVIDER=openrouter
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MAX_STEPS=25
# AI_HOURLY_LIMIT=60
